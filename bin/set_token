#!/bin/bash
# Токен Новостного сторожа — Олег запускает САМ в своём Терминале (не через Claude): ~/PyCharmMiscProject/news-watch/bin/set_token
#   1. токен — скрытым вводом (на экране ничего), в командную строку и историю оболочки не попадает;
#   2. проверка в Telegram (getMe) прямо с мака — адрес с токеном уходит curl через stdin, не аргументом;
#   3. Олег пишет боту /start — так бот узнаёт его chat_id (белый список: отвечает только ему);
#   4. на сервер — потоком через ssh в /opt/news-watch/.env (root, 600), служба включается и стартует.
# Печатается только @имя бота и «записано».
set -euo pipefail
SERVER="${NEWS_SERVER:-root@209.250.234.38}"
tg() {   # tg <метод> [параметры] — токен не попадает в аргументы процессов
    printf 'url = "https://api.telegram.org/bot%s/%s"\n' "$TOKEN" "$1" | curl -s -m 30 -K - ${2:+--data "$2"}
}
read -rsp "Токен от @BotFather (не отображается): " TOKEN; echo
[ -n "$TOKEN" ] || { echo "пусто — выход"; exit 1; }
name=$(tg getMe | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["result"]["username"] if d.get("ok") else "")')
[ -n "$name" ] || { echo "Telegram не принял токен — проверь и запусти снова"; exit 1; }
# Белый список — только чат, приславший одноразовый код (чужой /start боту не пройдёт). Старые сообщения пропускаются.
CODE=$(openssl rand -hex 3)
last=$(tg getUpdates "offset=-1" | python3 -c 'import json,sys; r=json.load(sys.stdin).get("result",[]); print(r[-1]["update_id"]+1 if r else 0)')
echo "Бот: @$name. Отправь ему в Telegram:  /start $CODE   — жду до 3 минут…"
found=""
for _ in $(seq 1 18); do
    found=$(tg getUpdates "offset=$last&timeout=10" | CODE="$CODE" python3 -c '
import json, os, sys
for u in json.load(sys.stdin).get("result", []):
    m = u.get("message") or {}
    if m.get("chat", {}).get("type") == "private" and m.get("text", "").strip() == "/start " + os.environ["CODE"]:
        f = m.get("from", {})
        print(m["chat"]["id"], "@" + f.get("username", "") if f.get("username") else f.get("first_name", "?"))
        break')
    [ -n "$found" ] && break
done
[ -n "$found" ] || { echo "код не пришёл за 3 минуты — запусти снова"; exit 1; }
chat=${found%% *}
read -rp "Код прислал ${found#* }. Это ты? [y/N] " ok
[ "$ok" = y ] || [ "$ok" = Y ] || { echo "отмена — ничего не записано"; exit 1; }
printf 'NEWS_TG_TOKEN=%s\nNEWS_TG_CHAT_ID=%s\n' "$TOKEN" "$chat" | ssh -o BatchMode=yes "$SERVER" '
    umask 077; set -e
    test -d /opt/news-watch || { echo "на сервере нет /opt/news-watch — сначала scripts/deploy.sh"; exit 1; }
    cat > /opt/news-watch/.env.new && chown root:root /opt/news-watch/.env.new && chmod 600 /opt/news-watch/.env.new
    mv /opt/news-watch/.env.new /opt/news-watch/.env
    systemctl enable -q news-watch && systemctl restart news-watch && sleep 3 && echo "служба: $(systemctl is-active news-watch)"'
unset TOKEN
echo "✅ записано: @$name, твой чат — в белом списке. Нажми в боте «➕ монета»."
